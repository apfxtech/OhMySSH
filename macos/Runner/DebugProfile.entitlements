<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Outbound TCP to SSH hosts. Without this the sandbox blocks every connect. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Import/export of the vault and SFTP transfers via the file picker. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Auto-unlock (flutter_secure_storage) needs the macOS keychain, and the
	     keychain refuses a build that is signed ad-hoc (CODE_SIGN_IDENTITY = "-",
	     the Flutter default) with -34018 "A required entitlement isn't present".
	     Turning the sandbox off does NOT help — the problem is the missing
	     application-identifier, not the sandbox.

	     To enable it on macOS, once, in Xcode:
	       1. open macos/Runner.xcworkspace
	       2. Runner target -> Signing & Capabilities -> pick your Team
	          (this also registers the bundle id and generates a profile)
	       3. add the "Keychain Sharing" capability
	     Until then the toggle stays off and says why. Every other platform
	     works without any of this. -->
</dict>
</plist>
